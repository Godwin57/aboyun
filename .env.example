# Postgres (Neon / Supabase). Use the pooled connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Optional: non-pooled connection used only by `prisma migrate` (recommended on Neon / Supabase).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Better Auth. Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM="Aboyun <onboarding@resend.dev>"

# Africa's Talking (SMS + USSD)
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SHORTCODE=""
AT_CALLBACK_SECRET=""

# Protects /api/cron/* (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Optional: dev password for seeded admin + clinic users (see prisma/seed.ts)
# SEED_PASSWORD=""
