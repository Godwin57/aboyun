# Postgres (Neon). Run `neon deploy` (or `neon env pull`) to write these into .env.
# DATABASE_URL: pooled connection (host contains -pooler) used by the app.
# DATABASE_URL_UNPOOLED: direct connection used only by `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Supabase users: set DIRECT_URL to the direct connection instead.
# DIRECT_URL=""

# Better Auth. Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM="Aboyun <onboarding@resend.dev>"

# Africa's Talking (SMS + USSD)
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SHORTCODE=""
AT_CALLBACK_SECRET=""

# Protects /api/cron/* (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Optional: dev password for seeded admin + clinic users (see prisma/seed.ts)
# SEED_PASSWORD=""

# Optional: send SMS through Twilio (a demo helps: the Africa's Talking sandbox only reaches its
# simulator). Used only when all three are set. USSD and incoming SMS stay on Africa's Talking.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
